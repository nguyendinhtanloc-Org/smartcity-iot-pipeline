# telegraf.conf
# Trỏ về broker THẬT (dathoc.net) — mentor đã bật lại simulator.
# Topic dùng đúng "v1/C001/+/up/telemetry" khớp config/sources.yaml
# (broker hiện chỉ có company C001, nên cả 3 khu CN A/B/C cùng subscribe
# 1 topic, phân biệt bằng tag khu_cn — đúng như comment gốc trong
# config/sources.yaml: "3 nguồn MQTT — tất cả cùng subscribe C001").
#
# KHÔNG cần sửa detect_type_from_topic() trong schemas.py: gateway_id
# thật (GW_WATER_001, GW_LIGHT_001...) đã khớp đúng GATEWAY_TYPE_MAP.

[agent]
  interval = "1s"
  flush_interval = "5s"
  metric_buffer_limit = 100000   # <-- "kiểm soát tốc độ" built-in của tool
  collection_jitter = "0s"

# ================== Khu CN A ==================
[[inputs.mqtt_consumer]]
  name_override = "iot_raw"
  servers = ["wss://dathoc.net:443/mq"]
  topics = ["v1/C001/+/up/telemetry"]
  username = "test1"
  password = "123456"
  qos = 1                        # <-- tăng từ 0 lên 1: broker giữ lại msg chưa ACK khi mất kết nối
  persistent_session = true      # <-- không xóa session khi disconnect, cho phép nhận lại msg khi reconnect
  client_id = "telegraf-khu-cn-a"  # <-- BẮT BUỘC phải set khi persistent_session=true
  topic_tag = "topic"
  data_format = "value"
  data_type = "string"
  insecure_skip_verify = true
  [inputs.mqtt_consumer.tags]
    khu_cn = "A"
    source_name = "CN_A"

# ================== Khu CN B ==================
[[inputs.mqtt_consumer]]
  name_override = "iot_raw"
  servers = ["wss://dathoc.net:443/mq"]
  topics = ["v1/C001/+/up/telemetry"]
  username = "test1"
  password = "123456"
  qos = 1
  persistent_session = true
  client_id = "telegraf-khu-cn-b"
  topic_tag = "topic"
  data_format = "value"
  data_type = "string"
  insecure_skip_verify = true
  [inputs.mqtt_consumer.tags]
    khu_cn = "B"
    source_name = "CN_B"

# ================== Khu CN C ==================
[[inputs.mqtt_consumer]]
  name_override = "iot_raw"
  servers = ["wss://dathoc.net:443/mq"]
  topics = ["v1/C001/+/up/telemetry"]
  username = "test1"
  password = "123456"
  qos = 1
  persistent_session = true
  client_id = "telegraf-khu-cn-c"
  topic_tag = "topic"
  data_format = "value"
  data_type = "string"
  insecure_skip_verify = true
  [inputs.mqtt_consumer.tags]
    khu_cn = "C"
    source_name = "CN_C"

# ================== Output: GỘP cả 3 luồng về 1 nơi ==================
[[outputs.file]]
  files = ["/data/unified_events.jsonl"]
  data_format = "json"
